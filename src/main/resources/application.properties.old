spring.application.name=hr-stream

# App Configuration
server.port=8090


# Database Configuration
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/${POSTGRES_DB:${DB_NAME:hr_stream}}}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:${POSTGRES_USER:${DB_USER:postgres}}}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:${POSTGRES_PASSWORD:${DB_PASSWORD:123654}}}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

