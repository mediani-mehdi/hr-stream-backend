# Copy to .env and adjust values

# Postgres (used by compose)
POSTGRES_DB=hr-stream
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123

# MinIO
MINIO_ROOT_USER=minio_admin
# Must be at least 8 chars; use something non-trivial
MINIO_ROOT_PASSWORD=minio_admin_password_123
MINIO_BUCKET_NAME=ats-resumes

